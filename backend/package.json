{
  "name": "aeychhotu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AeyChhotu! backend skeleton — Express 5 + Supabase/Postgres",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "db:setup": "node scripts/db-setup.mjs",
    "db:setup:noseed": "node scripts/db-setup.mjs --no-seed",
    "db:verify": "node scripts/db-verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "keep-alive": "node scripts/keep-alive.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "8.23.0",
    "sharp": "^0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
