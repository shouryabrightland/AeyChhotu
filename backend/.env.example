# AeyChhotu! backend — copy to .env and fill in. Never commit .env.

# Port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Origin(s) of the Next.js client allowed by CORS — no trailing slash.
# Comma-separate to allow several, e.g. a production domain plus Vercel
# preview URLs:  https://app.example.com,https://aeychhotu.vercel.app
CLIENT_URL=http://localhost:3000

# SameSite attribute for the httpOnly kds_token cookie.
#   strict (default) — frontend and API share a site; never sent cross-site.
#   lax              — top-level navigations may carry it.
#   none             — frontend and API are on DIFFERENT sites (e.g. a Vercel
#                      app talking to an API on *.onrender.com). Forces
#                      `Secure` automatically, so HTTPS is required.
# Staff routes authenticate with the Bearer token regardless; this only
# affects the cookie convenience path.
COOKIE_SAME_SITE=strict

# Postgres connection string (Supabase → Connect → "Session pooler" URI).
# REQUIRED: the server refuses to boot if this variable is missing.
# Locally, the direct host (db.<ref>.supabase.co) works. On a hosted deploy it
# usually does NOT: that hostname resolves to IPv6 only, and most PaaS egress
# is IPv4 — the symptom is a timeout that looks like bad credentials. The
# Supavisor pooler (aws-0-<region>.pooler.supabase.com) resolves over IPv4 and
# fits this app's long-lived pool. See docs/11-deploy.md §1.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/aeychhotu

# Kitchen shift PIN (4-6 digits) checked by POST /api/v1/auth/kds-login.
STAFF_PIN=1234

# HMAC secret that signs the KDS bearer tokens (any long random string).
KDS_TOKEN_SECRET=change-me-to-a-long-random-string

# Supabase JWT secret (Supabase dashboard → Project Settings → API).
# OPTIONAL for REST, REQUIRED for Realtime after the RLS scoping fix:
# when set, E1 (diner) and E2 (staff) also issue the `realtime_token`
# whose claims the SELECT policies in sql/001_init.sql match on.
# Leave empty → realtime_token is null and the app runs REST-only.
SUPABASE_JWT_SECRET=

# Owner/manager console PIN (4-6 digits) checked by
# POST /api/v1/auth/admin-login. Separate from STAFF_PIN on purpose: the
# admin console can archive tables and rewrite the catalog.
ADMIN_PIN=998877

# ---- Dish photos ---------------------------------------------------
# Where the three derivatives per dish live. Leave IMAGE_STORAGE unset (or set
# it to "postgres") to keep the bytes in menu_image_objects — durable on a
# host whose disk is wiped on deploy, and the only mode that needs no extra
# account. Set IMAGE_STORAGE=supabase to use Supabase Storage instead; the
# bucket must exist and be PUBLIC READ (the admin uploads with the service
# role, diners only ever read).
IMAGE_STORAGE=postgres
# Required only when IMAGE_STORAGE=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MENU_BUCKET=menu-images

# ---- Ask Chhotu (client-side AI waiter) -----------------------------
# Google Gemini API key (https://aistudio.google.com/apikey).
# The backend never calls Gemini with it. It is released INSIDE the granted
# table session (initialize on an empty table, join-pin, join-pass,
# reconnect), so only a device that has joined a table ever receives it —
# never the JS bundle, never a pre-join scan reply. Because every guest at
# that table can read it from the network tab, use a RESTRICTED, quota-capped
# key. OPTIONAL: without it the app runs normally and the assistant stays
# hidden. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key
