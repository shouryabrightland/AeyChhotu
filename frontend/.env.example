# Frontend environment template — copy to .env.local (gitignored).
# No host string is ever hardcoded in code; everything loads from here.

# Express backend base URL, no trailing slash.
# NEXT_PUBLIC_API_URL=http://localhost:4000
#
# Or `/` (a.k.a. "same-origin"): the Next server proxies /api/* to
# API_PROXY_TARGET (default http://localhost:4000), so one exposed port serves
# the whole app and CORS never enters the picture.


# Supabase project for Realtime channels (browser).
# PUBLIC anon key ONLY — the service_role key must never ship to the client.
# Realtime needs ALL THREE of: these two vars here, plus
# SUPABASE_JWT_SECRET in backend/.env — that secret lets the backend mint
# the per-table `realtime_token` the RLS policies scope on (without it the
# browser holds only the anon key, the policies match no rows, and the app
# silently runs REST + polling — by design, never leaking other tables).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: there is no Gemini key here on purpose.
#
# Chhotu's key is NOT a build-time client variable any more. The backend
# (GEMINI_API_KEY in backend/.env) releases it inside the granted table
# session — POST /sessions/initialize on an empty table, /join-pin,
# /join-pass or /reconnect — so only a device that has proven it belongs to
# a table ever holds one. Adding it here would put it back in the bundle and
# defeat the gate.

# Live model behind Chhotu (voice-to-voice). Optional: defaults to
# gemini-3.8-live-extended-thinking, which accepts BOTH speech and typed text
# on one session. Point it only at a Live model — there is no text-model path.
# NEXT_PUBLIC_CHHOTU_LIVE_MODEL=gemini-3.8-live-extended-thinking

# There is deliberately no offline demo switch. If NEXT_PUBLIC_API_URL is
# unreachable the app shows its real error state with a Retry button; it never
# serves seeded dishes or seeded tickets as if they were live.
